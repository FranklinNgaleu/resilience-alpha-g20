# ============================================
# RESILIENCE-ALPHA - Configuration d'exemple
# Copier ce fichier en .env et adapter les valeurs
# Ne jamais utiliser de vrais secrets ici
# ============================================

# PostgreSQL
POSTGRES_DB=resilience
POSTGRES_USER=resilience
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Authentification JWT
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Compte de démonstration
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD_HASH=CHANGE_ME_WITH_VALID_PASSWORD_HASH

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# Services internes
ANOMALY_DETECTOR_URL=http://anomaly-detector:8001